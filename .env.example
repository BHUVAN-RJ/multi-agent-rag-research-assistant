# Copy to .env and fill in. Never commit .env.
# All three generation providers below have free tiers. No paid model is configured anywhere.

# --- NVIDIA NIM (free via NVIDIA Developer Program, OpenAI-compatible) ---
NVIDIA_API_KEY=nvapi-replace-me
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_STRONG=nvidia/nemotron-3-ultra-550b-a55b

# --- Google Gemini (free tier, AI Studio key) ---
GOOGLE_API_KEY=replace-me
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.8-flash

# --- OpenRouter (free ":free" models only, tried in order) ---
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODELS=openrouter/free

# --- Real-time knowledge (Tavily Remote MCP; DuckDuckGo is the keyless fallback) ---
TAVILY_API_KEY=tvly-replace-me

# --- RAG (local ONNX embeddings, no key) ---
CHROMA_PERSIST_DIR=./chroma_index
CHROMA_COLLECTION=arxiv_corpus
CORPUS_DIR=./data/corpus
# Cross-encoder re-ranker (local ONNX via fastembed). Empty disables re-ranking.
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_THREADS=2
RETRIEVAL_K=5

# --- Data agent ---
PAPERS_DB_PATH=./data/papers.db

# --- Cloud Run deployment ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=multi-agent-rag
